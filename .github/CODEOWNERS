# CODEOWNERS — required reviewers by blast radius, not by org chart.
# See adr/0001-blast-radius-tiers.md. Later rules win, so Kitchen paths are last.
# Rooms are also mapped in .github/house/rooms.config.js; keep the two in step.
#
# FILL IN: replace the team handles with your real ones.

# ---- Driveway: throwaway. No owner, expires (driveway-sweep.yml tows it). ----
tools/**                            @your-org/mobile
scripts/oneoff/**                   @your-org/mobile
analyses/**                         @your-org/mobile
dashboards/**                       @your-org/mobile

# ---- Garage: spikes. Light touch, must not ship. ----
sandbox/**                          @your-org/mobile
**/experiments/**                   @your-org/mobile

# ---- Living Room: core product. Normal review. ----
*                                   @your-org/mobile
composeApp/**                       @your-org/android
androidApp/**                       @your-org/android
iosApp/**                           @your-org/ios
feature/**                          @your-org/mobile
core/designsystem/**                @your-org/design-system @your-org/mobile
webApp/**                           @your-org/web
web/**                              @your-org/web
server/**                           @your-org/backend

# ---- Kitchen: money, auth, regulated, shared contracts. Two keys. ----
core/network/**                     @your-org/platform-mobile @your-org/security
core/auth/**                        @your-org/platform-mobile @your-org/security
core/wallet/**                      @your-org/platform-mobile @your-org/payments
core/compliance/**                  @your-org/platform-mobile @your-org/compliance
**/db/migration/**                  @your-org/backend @your-org/platform-mobile

# shared code is Kitchen: two platforms and a contract downstream
shared/**                                     @your-org/platform-mobile
shared/src/commonMain/**                      @your-org/platform-mobile @your-org/android @your-org/ios
shared/src/*/kotlin/**/model/**                @your-org/platform-mobile @your-org/backend-contracts

# ---- The door itself: nobody edits the gates alone. ----
